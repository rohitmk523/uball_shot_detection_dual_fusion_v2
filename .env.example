# Copy to .env and fill REAL values locally. .env is gitignored — never commit secrets.
# AWS (needs: read uball-videos-production + uball-cv-models; read/write uball-cv-results; ec2 run/terminate)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# uball.ai Supabase (annotator ground truth: the `plays` table)
SUPABASE_URL=https://mhbrsftxvxxtfgbajrlc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# AWS runtime guardrails (the autonomous loop reads these)
AWS_GPU_INSTANCE_TYPE=g4dn.xlarge
AWS_USE_SPOT=true
AWS_MAX_USD_PER_ITERATION=5
AWS_MAX_USD_TOTAL=60
AWS_INSTANCE_PROFILE=uball-cv-builder-profile
S3_WORK_PREFIX=s3://uball-cv-results/cv-results/dual-fusion-v2
